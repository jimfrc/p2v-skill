# p2v-agent model configuration
#
# Copy this file to `.env` and fill in your own DeepSeek API key.
# Get a key at https://platform.deepseek.com/
#
# `.env` is gitignored; do not commit real keys.

# Default backend: DeepSeek official API (OpenAI-compatible)
P2V_PROVIDER=deepseek

# Required: DeepSeek API key
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Optional: override the endpoint and model
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_MODEL=deepseek-reasoner

# You can also use the generic overrides instead:
# P2V_API_KEY=sk-your-deepseek-api-key
# P2V_BASE_URL=https://api.deepseek.com
# P2V_MODEL=deepseek-chat

# Optional: use a locally installed Chromium browser instead of letting
# Remotion download Chrome Headless Shell (~130 MB, slow on restricted
# networks). Auto-detected on Windows/macOS when unset.
# P2V_BROWSER_EXECUTABLE=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
# P2V_BROWSER_EXECUTABLE=off
